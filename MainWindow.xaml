<Window x:Class="Kalkulator_wynagrodzen_desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalkulator i Rejestr Wynagrodzen"
        Height="560"
        Width="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="0" Margin="0,0,0,14" Background="#F3F4F6" CornerRadius="0">
            <StackPanel>
                <TextBlock Text="Kalkulator Wynagrodzen - Autor: 00000000000" FontSize="13" Background="#4B5563" Foreground="Gainsboro" TextAlignment="Center" Margin="0,0,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="14" Margin="0,0,14,0" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Dane Wejsciowe" FontSize="17" FontWeight="Bold" Margin="0,0,0,14" />

                    <TextBlock Text="Wynagrodzenie brutto (PLN):" Margin="0,0,0,4" />
                    <TextBox x:Name="KwotaBruttoTextBox" Height="28" Padding="4" Margin="0,0,0,14" Text="6000,00" />

                    <TextBlock Text="Typ umowy:" Margin="0,0,0,6" />
                    <RadioButton x:Name="UmowaOPraceRadio" Content="Umowa o prace" IsChecked="True" Margin="0,0,0,4" />
                    <RadioButton x:Name="UmowaZlecenieRadio" Content="Umowa zlecenie" Margin="0,0,0,14" />

                    <CheckBox x:Name="UlgaMlodychCheckBox" Content="Ulga dla mlodych (&lt; 26 lat)" Margin="0,0,0,18" />

                    <Button Content="OBLICZ I ZAPISZ"
                            Height="38"
                            Background="#2563EB"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="ObliczIZapisz_Click" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12" Margin="0,0,0,10" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6">
                    <TextBlock x:Name="WynikNettoTextBlock"
                               Text="Wynagrodzenie netto: 0,00 PLN"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#15803D" />
                </Border>

                <Border Grid.Row="1" Padding="12" Margin="0,0,0,10" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Szczegoly Skladek i Podatkow" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock x:Name="SkladkiZusTextBlock" Text="Skladki ZUS (spoleczne): 0,00 PLN" Margin="0,0,0,4" />
                        <TextBlock x:Name="SkladkaZdrowotnaTextBlock" Text="Skladka zdrowotna: 0,00 PLN" Margin="0,0,0,4" />
                        <TextBlock x:Name="ZaliczkaPitTextBlock" Text="Zaliczka na podatek PIT: 0,00 PLN" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Padding="12" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <TextBlock Text="Rejestr Wynagrodzen" FontSize="15" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,8" />
                        <DataGrid x:Name="RejestrDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="140" />
                                <DataGridTextColumn Header="Kwota Brutto" Binding="{Binding KwotaBrutto}" Width="*" />
                                <DataGridTextColumn Header="Umowa" Binding="{Binding Umowa}" Width="*" />
                                <DataGridTextColumn Header="Netto" Binding="{Binding Netto}" Width="*" />
                                <DataGridTextColumn Header="Ulga" Binding="{Binding Ulga}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>